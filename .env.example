# Адрес, по которому сервер доступен из интернета (нужен для OAuth и для Instagram)
PUBLIC_URL=https://post.example.com
PORT=3000

# Пароль для входа в приложение — обязательно на публичном сервере
APP_PASSWORD=

# Секрет для сессий и шифрования токенов. Пусто — сгенерируется сам в data/secret
SESSION_SECRET=

# 1 — всё имитируется, соцсети не нужны. Удобно посмотреть интерфейс.
DEMO_MODE=0

# YouTube: console.cloud.google.com → YouTube Data API v3 → OAuth client (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Instagram: developers.facebook.com → приложение → Instagram API with Instagram Login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# TikTok: developers.tiktok.com → Login Kit + Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# inbox — видео во «Входящие» TikTok (работает без аудита); direct — сразу публично (нужен аудит)
TIKTOK_MODE=inbox

# X: developer.x.com → приложение → OAuth 2.0, тип Web App (confidential)
X_CLIENT_ID=
X_CLIENT_SECRET=

# Уведомления на телефон: создайте бота у @BotFather, chat id — у @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
